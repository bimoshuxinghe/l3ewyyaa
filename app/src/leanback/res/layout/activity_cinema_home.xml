<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_cinema"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Full-screen backdrop -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/coverBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.88"
        android:scaleType="centerCrop"
        android:visibility="invisible" />

    <!--
      背景压暗层：全屏底图之上再叠一层暗色，避免背景抢过内容。
      之前 bg_tv_cinema_backdrop_tint 等 6 个遮罩 drawable 已存在但未接入布局，
      导致背景"平"、缺少纵深，这里按 hellotv 的做法补齐分层。
    -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_cinema_backdrop_tint" />

    <!-- 左侧竖向压暗：保证 hero 区文字（标题/简介）在亮背景上也清晰 -->
    <View
        android:layout_width="720dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cinema_hero_overlay" />

    <!-- 底部渐深：让海报栏与上方内容自然分层 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_tv_cinema_bottom_gradient" />

    <!-- 顶栏区域轻微压暗，托住导航文字 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_tv_cinema_cover_tint" />

    <!-- Navigation bar -->
    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/siteName"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:drawablePadding="2dp"
            android:maxWidth="160dp"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/home_search"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="&#x76F4;&#x64AD;"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/keep"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="&#x6536;&#x85CF;"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/history"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/nav_history"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/push"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/home_push"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setting"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/nav_setting"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:textColor="@color/white_70"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/net"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_net_wifi" />
    </LinearLayout>

    <!-- Category tabs -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/categories"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="72dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone"
        app:focusOutEnd="false"
        app:focusOutFront="false" />

    <!-- Hero section: constrained to left 1/3 so background poster is visible -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="118dp"
        android:orientation="vertical">

        <!-- Movie title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/siteIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- TMDB 标题 Logo：尺寸调大一点，仍限制在标题行内，不遮挡下面的简介 -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/appTitleLogo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:maxWidth="360dp"
                android:scaleType="fitStart"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Actor info -->
        <TextView
            android:id="@+id/actor"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="#FFC8D0E8"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Tag row: year, area, type -->
        <LinearLayout
            android:id="@+id/tagRow"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tagYear"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_cinema_tag_chip"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tagArea"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_cinema_tag_chip"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tagType"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_cinema_tag_chip"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Synopsis: shown directly over the backdrop poster -->
        <TextView
            android:id="@+id/tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="5"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:text="@string/home_tip"
            android:textColor="#FFD0D8F0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom poster carousel -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/posters"
        android:layout_width="match_parent"
        android:layout_height="264dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="-6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:focusOutEnd="false"
        app:focusOutFront="false" />

    <!-- Loading indicator -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="120dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/loadingProgress"
            style="?android:progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_loading"
            android:textColor="@color/white_70"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>
