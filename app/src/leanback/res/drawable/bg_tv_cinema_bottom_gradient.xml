<?xml version="1.0" encoding="utf-8"?>
<!--
  底部渐深遮罩
  与 bg_tv_cinema_bottom_gradient 不同：此版本自上而下渐深，
  最底部接近实色，保证海报栏与上方内容自然分层、边界不生硬
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#8A05070C"
        android:centerY="0.45"
        android:endColor="#F205070C"
        android:startColor="#0005070C"
        android:type="linear" />
</shape>
